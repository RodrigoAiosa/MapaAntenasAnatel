# Variáveis opcionais do build (configure em Vercel > Settings > Environment Variables)

# URL pública (canonical, Open Graph, sitemap). Padrão: VERCEL_PROJECT_PRODUCTION_URL.
# SITE_URL=https://seu-dominio.com.br

# 1 = gera e publica também a planilha Excel em /dados/ (build ~1 min mais lento)
# INCLUIR_PLANILHA=1

# Recorte por UF para testes rápidos (vazio = Brasil inteiro)
# UFS=SC,PR

# Foto da rua no balao do ponto (opcional). Chave da Street View Static API do Google,
# restrita por referenciador ao seu dominio e com limite de cota. Sem ela o balao mostra so o link.
STREETVIEW_KEY=
